# AI-ROS Backend Environment Configuration
# Copy this file to .env and fill in real values.

DEBUG=false
ENVIRONMENT=production

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Security — MUST be at least 32 characters each
SECRET_KEY=your-secret-key-min-32-chars-here
ENCRYPTION_KEY=your-encryption-key-min-32-chars-here

# Database
DATABASE_URL=postgresql+asyncpg://airos:airos_dev_password@localhost:5432/airos

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-placeholder
