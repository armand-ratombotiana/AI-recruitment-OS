# =============================================================================
# AI-ROS Environment Variables — Copy to .env and fill in values
# =============================================================================
# Usage: cp .env.example .env && nano .env
# =============================================================================

# --- Application ---
APP_NAME=AI-ROS
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# --- Security (CHANGE IN PRODUCTION!) ---
SECRET_KEY=change-me-to-a-random-32-char-string
ENCRYPTION_KEY=change-me-to-another-random-32-char

# --- Database ---
POSTGRES_DB=airos
POSTGRES_USER=airos
POSTGRES_PASSWORD=airos_dev_password
DATABASE_URL=postgresql+asyncpg://airos:airos_dev_password@postgres:5432/airos

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200

# --- AI Providers ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_ORG_ID=
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Observability ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=airos
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
