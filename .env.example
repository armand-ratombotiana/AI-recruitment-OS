# =============================================================================
# AI-ROS Environment Variables — Copy to .env and fill in values
# =============================================================================

# --- Application ---
APP_NAME=AI-ROS
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# --- Security (CHANGE IN PRODUCTION) ---
SECRET_KEY=change-me-to-a-random-32-char-string
ENCRYPTION_KEY=change-me-to-another-random-32-char

# --- Database ---
DATABASE_URL=postgresql+asyncpg://airos:airos_dev_password@localhost:5432/airos

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200

# --- AI Providers ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_ORG_ID=
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Observability ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-ros
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
